# --- ERPNext connection (service-level, held only by the agent server) ---
# Used only for privileged introspection (getUserRoles). Every business-data
# call runs as the actual logged-in person, not this key — see docs/ARCHITECTURE.md.
ERPNEXT_BASE_URL=https://your-erpnext-site.example.com
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret

# --- Inbound webhooks (ERPNext -> this server, see docs/WEBHOOK_SETUP.md) ---
# Must match the "Webhook Secret" field on the ERPNext Webhook record.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ERPNEXT_WEBHOOK_SECRET=

# --- Which business system to talk to ---
# "erpnext" today; write another SystemConnector + flip this to add a second.
SYSTEM_PROVIDER=erpnext

# --- Agent's own JWT ---
AGENT_JWT_SECRET=change_this_to_a_long_random_string
AGENT_JWT_EXPIRES_IN=8h

# --- Module plugin loader ---
# Hand-written modules + the generic factory flags ("entities" loads
# config/entities.config.ts, "workflows" config/workflows.config.ts,
# "reports" config/reports.config.ts). tool_discovery is always on.
ACTIVE_MODULES=context,tickets,email,project_issue,document,analytics,chart,report_generate,payment_entry_actions,inbox_actions,schema_search,data_server,entities,workflows,reports

# --- LLM (OpenAI-compatible; swap provider via LLM_PROVIDER + a new class) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOOL_ITERATIONS=8
# Optional — informational ceiling only in the self-hosted build.
LLM_MAX_TOKENS_PER_MINUTE=200000

# --- Context budgets ---
CONTEXT_SESSION_TURNS=6
CONTEXT_VECTOR_TOPK=5
CONTEXT_BUDGET_CHARS=6000

# --- Embeddings (prompt vector search + admin-uploaded policy documents) ---
# Optional: defaults to reusing LLM_API_KEY / an OpenAI-compatible endpoint.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Postgres (pgvector + interaction_log). Never ERPNext's own DB. ---
DATABASE_URL=postgres://user:password@localhost:5432/erp_agent

# Optional — only needed to share session/cache state across >1 backend process.
REDIS_URL=

PORT=4000
ADMIN_ROLES=System Manager

# Encrypts admin-provisioned user API credentials at rest (user_credentials
# table). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Persistent multi-thread chat history — off by default, flip to "true" to
# surface the history sidebar in the agent app.
CHAT_HISTORY_ENABLED=false

# Comma-separated browser origins allowed to call this API (defense in depth;
# auth is a bearer token, never a cookie).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
